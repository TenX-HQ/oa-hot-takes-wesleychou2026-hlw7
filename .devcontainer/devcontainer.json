{
  "name": "TenX Assessment — Hot Takes Tournament",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "containerEnv": {
    "DATABASE_URL": "/workspaces/${localWorkspaceFolderBasename}/app.db",
    "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}/backend"
  },
  "onCreateCommand": "pip install -q tenx-ai && ([ -d frontend/node_modules ] || npm --prefix frontend ci --prefer-offline)",
  "updateContentCommand": "pip install -q tenx-ai",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Backend API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "TenX-HQ/hot-takes-tournament": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "-github.copilot",
        "-github.copilot-chat",
        "-github.copilot-labs",
        "-github.copilot-nightly",
        "ms-python.python",
        "ms-python.pylint",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "chat.disableAIFeatures": true,
        "chat.agent.enabled": false,
        "github.copilot.enable": { "*": false },
        "github.copilot.editor.enableAutoCompletions": false,
        "github.copilot.chat.agent.runTasks": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
        "editor.formatOnSave": true
      }
    }
  },
  "remoteEnv": {
    "MODEL": "claude-sonnet-4-5-20250929",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },
  "remoteUser": "root"
}
